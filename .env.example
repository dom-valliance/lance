DATABASE_URL=postgres://postgres:postgres@localhost:5432/lance
NODE_ENV=development

# Origin the browser reaches the api on. The delegated Graph consent flow
# registers ${PUBLIC_API_URL}/auth/graph/callback as its redirect URI.
PUBLIC_API_URL=http://localhost:3001

# Entra app registration (docs/runbooks/entra-setup.md). Identifiers, not secrets.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ALLOWED_UPN=

# Key Vault holding graph-refresh-token, as printed by docs/runbooks/deploy.md step 3.
KEY_VAULT_URL=

# Local development only. Lets a watcher run against a mailbox without a vault;
# no deployed environment sets it, and the value is a secret.
GRAPH_REFRESH_TOKEN=

# Phase 2. Identifiers, not secrets; every one has a default that matches dev.
# Who Lance works for. DOM_EMAIL defaults to ALLOWED_UPN.
DOM_NAME=Dom Selvon
DOM_EMAIL=
# Notion Meetings DB data source (read-only; ADR 0009 keeps tasks the only write target).
NOTION_MEETINGS_DATA_SOURCE_ID=1fc57534-6e48-804e-a193-000bec4176ab
# Local development only: the Jamie personal read key (jk_...). Deployed environments bind it from Key Vault.
JAMIE_API_KEY=

# Phase 3. Both are set by the template in Azure; local runs may leave them empty.
# The Log Analytics workspace id (customerId) the agent-logs watcher queries for Lance's own telemetry.
LOG_ANALYTICS_WORKSPACE_ID=
# Where the web app lives, for links from Slack back to the Alerts page.
PUBLIC_WEB_URL=http://localhost:3000
