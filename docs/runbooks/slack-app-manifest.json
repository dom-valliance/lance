{
  "display_information": {
    "name": "Lance",
    "description": "Dom's personal operating agent. Proposes actions, prepares the day, keeps a ledger.",
    "background_color": "#1f1f1f"
  },
  "features": {
    "bot_user": {
      "display_name": "Lance",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/lance",
        "url": "https://<api-hostname>/slack/commands",
        "description": "status, pause, resume, brief, task, chase",
        "usage_hint": "status | pause [reason] | resume | brief | task <text> | chase <commitment id>",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "reactions:read",
        "reactions:write",
        "commands",
        "users:read"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://<api-hostname>/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
