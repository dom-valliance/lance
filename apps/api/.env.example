# apps/api. Copy to .env for local development. Secrets come from Key Vault
# in every deployed environment; never commit a real value.

NODE_ENV=development
PORT=3001

# Postgres. Production reaches the server with an Entra token instead (ADR 0008).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lance

# Entra app registration, docs/runbooks/entra-setup.md. Identifiers, not secrets.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ALLOWED_UPN=dom@valliance.ai

# Slack app, docs/runbooks/slack-app-setup.md. Without the bot token the api
# still answers every route; it just cannot redraw a card or open a modal.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0BU7P278N5
# Dom's Slack user id, from users.slack_user_id. Unset refuses every pause
# and resume from Slack.
SLACK_ALLOWED_USER_ID=

# Shared secret for POST /ingest/agent-log (spec 7.1, agent-logs).
AGENT_LOG_INGEST_SECRET=

# Display name in Slack copy and the UI.
AGENT_DISPLAY_NAME=Lance
