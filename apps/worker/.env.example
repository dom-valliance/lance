# Database: DATABASE_URL locally; PG_HOST, PG_PORT, PG_DATABASE, PG_USER and PG_SSL=require in Azure (ADR 0008).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lance
NODE_ENV=development
LANCE_MODE=dry_run
AGENT_DISPLAY_NAME=Lance

# Model agents (spec 7). Without the key the worker runs watchers and the executor only.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Microsoft Graph (spec 4.1). Without these three the Graph connector and watchers are not started.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Refresh token store: Key Vault in Azure, or a dev-only token in memory locally.
# KEY_VAULT_URL=https://kv-lance-dev-xxxxx.vault.azure.net/
# GRAPH_REFRESH_TOKEN=

# Notion (ADR 0009). Without the token create_task proposals cannot execute.
NOTION_TOKEN=

# Slack surface (ADR 0012). Without the token proposals are recorded and shown in the UI only.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0BU7P278N5
