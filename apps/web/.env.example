# Auth.js
AUTH_SECRET=

# Microsoft Entra ID (names match the Bicep bindings in infra/)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# The single UPN allowed to sign in. Case-insensitive; see src/auth/allowlist.ts.
ALLOWED_UPN=

# Shown at the top of the sidebar and anywhere else the agent's name appears in UI copy.
AGENT_DISPLAY_NAME=Lance

# Base URL of apps/api, used to build the (not yet wired up) SSE endpoint.
NEXT_PUBLIC_API_URL=http://localhost:3001
